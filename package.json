{
  "name": "care-point",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:patient": "cross-env CAREPOINT_SURFACE=patient WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:clinic": "cross-env CAREPOINT_SURFACE=clinic WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:patient": "cross-env CAREPOINT_SURFACE=patient WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:clinic": "cross-env CAREPOINT_SURFACE=clinic WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/dates.test.mts tests/clinic.test.mts tests/ics.test.mts tests/i18n.test.mts tests/booking-rules.test.mts tests/schedule.test.mts tests/observability.test.mts tests/dsr.test.mts tests/trusted-proxy.test.mts tests/csrf.test.mts tests/surface.test.mts tests/notifications.test.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "deploy": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "test:scrub": "node --experimental-strip-types --test tests/observability.test.mts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
